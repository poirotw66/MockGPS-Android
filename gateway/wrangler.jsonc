{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloomwalk-gps-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production",
    "SEARCH_ENABLED": "false",
    "ROUTING_ENABLED": "true",
    "PURCHASES_ENABLED": "false",
    "ADS_ENABLED": "false",
    "PRIVACY_POLICY_URL": "https://bloomwalk-gps.pages.dev/privacy/zh-Hant/",
    "SUPPORT_URL": "https://bloomwalk-gps.pages.dev/support/zh-Hant/",
    "GEO_LEDGER_ID": "geo-ledger-v1",
    "GEO_PROVIDER_MODE": "live",
    "PLAY_API_MODE": "stub",
    "ALLOW_EMPTY_LEDGER_INIT": "true",
    "GEO_CREDIT_BUDGET_24H": "2700",
    "GEO_GLOBAL_MIN_INTERVAL_MS": "300",
    "CLIENT_SEARCH_LIMIT_24H": "30",
    "CLIENT_ROUTE_LIMIT_24H": "10",
    "CLIENT_MIN_INTERVAL_MS": "2000",
    "IP_REQUEST_LIMIT_PER_MINUTE": "120",
    "PROVIDER_TIMEOUT_MS": "10000",
    "MAX_IN_FLIGHT_GEO": "4",
    "CLOCK_MARGIN_MS": "60000",
    "BILLING_POLICY_JSON": "{\"version\":\"owner-accepted-route-exposure-v1\",\"evidence\":\"Search reserves 1 credit from Geoapify public geocoding pricing. Route reserves 25 credits: OWNER_ACCEPTED_SOFT_QUOTA_ROUTE_25. This is an owner-accepted ledger reservation from the published partial formula (waypoints minus 1 at the 25-point cap, plus one 500 km bucket). It is not a provider hard cap and not a worst-case proof.\",\"documentedMaximumCredits\":{\"search\":1,\"route\":25}}",
    "RECEIPT_ISSUER": "bloomwalk-gps-gateway",
    "RECEIPT_AUDIENCE": "com.bloss0m.bloomwalk",
    "ALLOWED_PACKAGE_NAME": "com.bloss0m.bloomwalk",
    "ALLOWED_PRODUCT_ID": "remove_ads_lifetime",
  },
  "durable_objects": {
    "bindings": [
      { "name": "GEO_BUDGET", "class_name": "GeoBudget" },
      { "name": "PURCHASE", "class_name": "Purchase" },
    ],
  },
  "exports": {
    "GeoBudget": { "type": "durable-object", "storage": "sqlite" },
    "Purchase": { "type": "durable-object", "storage": "sqlite" },
  },
}
